{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Config (don't use directly!)",
            "generator": "Ninja Multi-Config",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "$<$<CONFIG:Release,Debug,RelWithDebInfo>:Embedded>",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
            }
        },
        {
            "name": "default-vcpkg",
            "displayName": "Default Config for vcpkg (don't use directly!)",
            "generator": "Ninja Multi-Config",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "$<$<CONFIG:Release,Debug,RelWithDebInfo>:Embedded>",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/ports",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets"
            }
        },
        {
            "name": "win64vk",
            "displayName": "Windows 64-bit Vulkan Core Release (ONLY SUPPORTED WINDOWS BUILD)",
            "description": "Canonical Windows build. SAGE_USE_VULKAN_CORE=ON; never use the retired win64/win32/vc6 presets.",
            "inherits": "default",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "SAGE_USE_VULKAN_CORE": "ON",
                "SAGE_USE_DX8": "ON",
                "SAGE_USE_SDL3": "OFF",
                "SAGE_USE_OPENAL": "OFF",
                "SAGE_USE_MINIAUDIO": "ON",
                "SAGE_USE_GLM": "ON",
                "SAGE_UPDATE_CHECK": "OFF",
                "SAGE_USE_NGMP": "OFF",
                "RTS_BUILD_OPTION_FFMPEG": "OFF",
                "RTS_BUILD_GENERALS": "OFF",
                "RTS_BUILD_ZEROHOUR": "ON",
                "RTS_BUILD_CORE_TOOLS": "OFF",
                "RTS_BUILD_ZEROHOUR_TOOLS": "OFF"
            }
        },
        {
            "name": "linux64-deploy",
            "displayName": "Linux 64-bit DXVK/SDL3/OpenAL Release",
            "inherits": "default-vcpkg",
            "generator": "Ninja",
            "hidden": false,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "SAGE_USE_DX8": "OFF",
                "SAGE_USE_SDL3": "ON",
                "SAGE_USE_OPENAL": "ON",
                "SAGE_USE_MINIAUDIO": "OFF",
                "SAGE_USE_GLM": "ON",
                "SAGE_UPDATE_CHECK": "ON",
                "RTS_CRASHDUMP_ENABLE": "OFF",
                "RTS_BUILD_OPTION_FFMPEG": "ON"
            }
        },
        {
            "name": "macos-vulkan",
            "displayName": "macOS (MoltenVK + SDL3 + MiniAudio) arm64 Native",
            "inherits": "default-vcpkg",
            "generator": "Ninja",
            "hidden": false,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
                "SAGE_USE_DX8": "OFF",
                "SAGE_USE_SDL3": "ON",
                "SAGE_USE_OPENAL": "OFF",
                "SAGE_USE_MINIAUDIO": "ON",
                "SAGE_USE_GLM": "ON",
                "SAGE_USE_MOLTENVK": "ON",
                "SAGE_UPDATE_CHECK": "ON",
                "RTS_CRASHDUMP_ENABLE": "OFF",
                "RTS_BUILD_OPTION_FFMPEG": "ON",
                "RTS_BUILD_OPTION_SAGE_PATCH": "ON"
            },
            "environment": {
                "PKG_CONFIG_PATH": "/opt/homebrew/lib/pkgconfig"
            },
            "description": "Phase 5 macOS port: arm64 native (Apple Silicon) with MoltenVK for graphics, SDL3 for windowing, MiniAudio for audio."
        },
        {
            "name": "linux64-miniaudio",
            "displayName": "Linux 64-bit DXVK/SDL3/MiniAudio Release",
            "inherits": "linux64-deploy",
            "generator": "Ninja",
            "hidden": false,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "SAGE_USE_OPENAL": "OFF",
                "SAGE_USE_MINIAUDIO": "ON"
            },
            "description": "Experimental: Linux build with miniaudio audio backend instead of OpenAL+FFmpeg. Single-header library for audio playback/capture."
        }
    ],
    "buildPresets": [
        {
            "name": "win64vk",
            "displayName": "Windows 64-bit Vulkan Core Release",
            "configurePreset": "win64vk",
            "configuration": "Release",
            "targets": [
                "z_generals"
            ]
        },
        {
            "name": "linux64-deploy",
            "configurePreset": "linux64-deploy",
            "displayName": "Build Linux 64-bit DXVK/SDL3/OpenAL Release",
            "description": "Build Linux 64-bit with DXVK graphics, SDL3 windowing, and OpenAL audio"
        },
        {
            "name": "linux64-miniaudio",
            "configurePreset": "linux64-miniaudio",
            "displayName": "Build Linux 64-bit DXVK/SDL3/MiniAudio Release",
            "description": "Build Linux 64-bit with DXVK graphics, SDL3 windowing, and MiniAudio audio (experimental)"
        }
    ],
    "workflowPresets": []
}
